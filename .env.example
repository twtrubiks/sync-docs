# PostgreSQL 設定
POSTGRES_DB=postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password123  # TODO: 正式環境請更換為安全密碼

# Django 設定
DJANGO_SECRET_KEY=your_django_secret_key_here  # TODO: 正式環境請更換為安全密鑰
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Redis 設定
REDIS_HOST=django-redis
REDIS_PORT=6379

# CORS 設定
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 設定 — 供應商切換：nvidia（NIM，OpenAI 相容端點）| gemini（Google 原生 SDK）
AI_PROVIDER=nvidia
# NVIDIA NIM（取得 key：https://build.nvidia.com/）
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Gemini（AI_PROVIDER=gemini 時生效，取得 key：https://aistudio.google.com/）
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
