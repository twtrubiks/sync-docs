# Django 設定
DJANGO_SECRET_KEY=your_django_secret_key_here  # TODO: 正式環境請更換為安全密鑰
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com

# 資料庫設定
POSTGRES_HOST=django-postgres
POSTGRES_DB=postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_secure_password_here  # TODO: 正式環境請更換為安全密碼
POSTGRES_PORT=5432

# Redis 設定
REDIS_HOST=django-redis
REDIS_PORT=6379

# CORS 設定
CORS_ALLOWED_ORIGINS=https://your-domain.com

# WebSocket 設定 (選填)
# WEBSOCKET_MAX_MESSAGE_SIZE=262144
# WEBSOCKET_MAX_OPS_COUNT=1000
# WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
# WEBSOCKET_RATE_LIMIT_MESSAGES=30
# WEBSOCKET_RATE_LIMIT_WINDOW=10

# 生產環境 SSL 設定 (選填)
# SECURE_SSL_REDIRECT=True

# AI 設定 — 供應商切換：nvidia（NIM，OpenAI 相容端點）| gemini（Google 原生 SDK）
AI_PROVIDER=nvidia
# NVIDIA NIM（取得 key：https://build.nvidia.com/）
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Gemini（AI_PROVIDER=gemini 時生效，取得 key：https://aistudio.google.com/）
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
